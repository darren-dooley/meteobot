# Copy to .env and paste your key in:  cp .env.example .env
# .env is loaded at startup without overriding variables already exported in
# your shell, so an inline OPENAI_API_KEY=... still wins.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown).
# METEOBOT_MODEL=gpt-4.1-mini
# METEOBOT_HTTP_TIMEOUT=10.0
# METEOBOT_REQUEST_LIMIT=6
# METEOBOT_TOTAL_TOKENS_LIMIT=100000
# METEOBOT_LOG_LEVEL=WARNING

# Optional: LangSmith tracing over OpenTelemetry. Off by default; fails open if
# enabled without a key. Turn it on and supply a key to trace every Turn.
# METEOBOT_TRACING=true
# LANGSMITH_API_KEY=ls-...
# LANGSMITH_PROJECT=meteobot
# LANGSMITH_OTEL_ENDPOINT=https://api.smith.langchain.com/otel
